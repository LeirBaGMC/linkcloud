# Copiar como .env dentro de backend/ antes de iniciar FastAPI.
AWS_REGION=us-east-1

# Crear manualmente esta tabla con short_code (String) como clave de partición.
DYNAMODB_TABLE_NAME=shortened_urls

# Dirección pública que atiende GET /{short_code}.
# Cambiarla al desplegar en EC2 o publicar mediante CloudFront.
PUBLIC_BASE_URL=http://localhost:8000

# Lista JSON de orígenes autorizados, sin barra final.
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# No guardar claves AWS aquí. En EC2 se utilizará el rol IAM.
# Para desarrollo local debe existir una sesión AWS válida para Boto3.
